{
  "name": "mi-sistema",
  "version": "1.0.0",
  "description": "Demo de monitoreo GPS, preoperacional y PESV para flotas",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:frontend": "node scripts/generate-runtime-config.js",
    "test": "node scripts/smoke-test.js",
    "test:smoke": "node scripts/smoke-test.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "node seed.js",
    "mobile:prepare": "node scripts/generate-runtime-config.js && npx cap sync android",
    "android:debug": "cd android && gradlew.bat assembleDebug"
  },
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@prisma/client": "^5.22.0",
    "axios": "^1.16.0",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
